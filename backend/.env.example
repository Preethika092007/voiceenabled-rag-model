# EchoRAG Backend Configuration

# Server settings
PORT=8000
HOST=0.0.0.0

# CORS settings
# Comma-separated list of allowed origins. Use * for testing, but specify explicit origins for production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://your-vercel-deployment.vercel.app

# Reranking Configuration
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5

# LLM Configuration
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-8b-8192

# ElevenLabs STT Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_STT_MODEL=scribe_v2
